# Reference reverse-proxy config for the mikrus nginx in front of gunicorn.
# Not applied automatically by CI - copy/adapt into the server's nginx config once.

server {
    listen 20122;
    server_name srv63.mikr.us;

    location /static/ {
        alias /home/sheriff_bike/staticfiles/;
    }

    location /media/ {
        alias /home/sheriff_bike/media/;
    }

    location / {
        proxy_pass http://unix:/home/sheriff_bike/run/gunicorn.sock;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Contact/booking form (POST /api/contact_form/) - Cloudflare Turnstile secret key
# (the public site key goes in frontend/.env as VITE_TURNSTILE_SITE_KEY, not here)
# TURNSTILE_SECRET_KEY=

# Contact/booking form - Google Sheets destination for leads, via a service
# account shared (Editor) on the sheet. GOOGLE_SERVICE_ACCOUNT_FILE is a path
# to the downloaded key JSON (keep it out of the repo - see .gitignore);
# GOOGLE_SERVICE_ACCOUNT_JSON is the same credentials inlined as one line,
# used instead if no file path is set.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_WORKSHEET_NAME=Zgłoszenia
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Google reviews shown on the landing page (GET /api/reviews/), via the
# Places API (New). Server-side key only - restrict it to the Places API in
# Google Cloud. GOOGLE_PLACE_ID is the shop's Place ID (ChIJ...), which you
# can look up with Google's Place ID Finder. Leave blank to keep the
# hardcoded frontend numbers.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

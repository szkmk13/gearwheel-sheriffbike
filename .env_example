DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production only: the scheme://host(:port) the SPA is served from, e.g.
# https://sheriffbike.example. Django checks the Origin header of every unsafe
# request against it. Not needed locally - the Vite proxy keeps dev same-origin.
# CSRF_TRUSTED_ORIGINS=

# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Contact/booking form (POST /api/contact_form/) - Cloudflare Turnstile secret key
# (the public site key goes in frontend/.env as VITE_TURNSTILE_SITE_KEY, not here)
# TURNSTILE_SECRET_KEY=

# Contact/booking form - Google Sheets destination for leads, via a service
# account shared (Editor) on the sheet. GOOGLE_SERVICE_ACCOUNT_FILE is a path
# to the downloaded key JSON (keep it out of the repo - see .gitignore);
# GOOGLE_SERVICE_ACCOUNT_JSON is the same credentials inlined as one line,
# used instead if no file path is set.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_WORKSHEET_NAME=Zgłoszenia
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Google reviews shown on the landing page (GET /api/reviews/), via the
# Places API (New). Server-side key only - restrict it to the Places API in
# Google Cloud. GOOGLE_PLACE_ID is the shop's Place ID (ChIJ...), which you
# can look up with Google's Place ID Finder. Leave blank to keep the
# hardcoded frontend numbers.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# Production only, once the site is reachable exclusively over HTTPS:
# redirect plain HTTP and send HSTS (browsers then refuse HTTP for that many
# seconds - start low, e.g. 3600, before going to 31536000).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

# Error alerts by email via Gmail SMTP (production). 500 errors and failed
# backups are mailed to ADMIN_EMAILS (comma-separated). EMAIL_HOST_PASSWORD is
# a Google *app password* (needs 2FA on the account), not the Gmail password.
# Leave ADMIN_EMAILS empty and nothing is sent.
# ADMIN_EMAILS=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Backups (python manage.py backup_db, daily via deploy/gearwheel-backup.timer).
# BACKUP_DIR defaults to <repo>/backups. BACKUP_RCLONE_REMOTE is an rclone
# target, e.g. gdrive:sheriff-bike-backups - empty means local copies only.
# HEALTHCHECK_PING_URL is a healthchecks.io check URL (alert if no backup in a day).
# BACKUP_DIR=
# BACKUP_RCLONE_REMOTE=
# HEALTHCHECK_PING_URL=
